function getIdFromUrl() { const urlParams = new URLSearchParams(window.location.search); let id = urlParams.get('id'); if (!id && window.location.href.includes('?id=')) { id = window.location.href.split('?id=')[1].split('&')[0]; } return id; }
const id = getIdFromUrl(); const detail = document.getElementById('detail');
if (id && RECIPES[id]) {
  const r = RECIPES[id];
  detail.innerHTML = `<div class="detail-hero"><img src="${r.img}" alt="${r.name}" onerror="this.src='https://images.unsplash.com/photo-1547592180-85f173990554?w=1200'"></div>
    <div class="detail-content"><h1>${r.name}</h1><p class="detail-meta"><span>⏱ ${r.time}</span><span>👥 ${r.servings}</span></p>
      <h4>🧺 Ingrédients</h4><ul>${r.ingredients.map(i => `<li>${i}</li>`).join('')}</ul>
      <h4>👩‍🍳 Préparation</h4><ol>${r.steps.map(s => `<li>${s}</li>`).join('')}</ol>
      <div class="detail-actions"><a href="courses.html" class="btn-primary">Ajouter aux courses 🛒</a><a href="recettes.html" class="btn-secondary">← Autres recettes</a></div>
    </div>`;
} else {
  detail.innerHTML = `<div class="empty" style="padding: 60px 20px;"><h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; margin-bottom: 12px; color: var(--texte);">Oups, recette introuvable 🌸</h3><p style="margin-bottom: 24px;">Il semble que le lien soit cassé ou que la recette n'existe pas.</p><a href="recettes.html" class="btn-primary">Voir toutes les recettes</a></div>`;
}
</script>
