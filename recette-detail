  'slata-mechouia': { name: "Slata Mechouia", img: "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=1200", time: "30 min", servings: "4 personnes", ingredients: ["3 poivrons", "4 tomates", "1 oignon", "2 gousses d'ail", "1 boîte de thon", "2 œufs durs", "Huile d'olive"], steps: ["Grillez les poivrons, tomates et oignon.", "Pelez et hachez finement.", "Ajoutez l'ail écrasé, l'huile d'olive et le sel.", "Garnissez de thon et d'œufs durs.", "Servez froid avec du pain."] },
