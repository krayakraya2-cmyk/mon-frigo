  'marqa-hlowa': { name: "Marqa Hlowa", img: "https://images.unsplash.com/photo-1574484284002-952d92456975?w=1200", time: "1h15", servings: "6 personnes", ingredients: ["800g d'agneau", "200g de pruneaux", "100g d'amandes", "2 c. à s. de miel", "1 c. à c. de cannelle", "2 oignons", "Huile"], steps: ["Faites revenir l'agneau avec l'oignon.", "Ajoutez la cannelle et couvrez d'eau.", "Laissez mijoter 45 min.", "Ajoutez les pruneaux et le miel, cuisez 15 min.", "Garnissez d'amandes grillées et servez."] },
