  .detail-content { background: var(--blanc); border-radius: var(--rayon-lg); padding: 36px; box-shadow: var(--ombre); border: 1px solid rgba(238, 170, 179, 0.15); }
  .detail-content h1 { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--texte); margin-bottom: 12px; letter-spacing: -0.5px; }
  .detail-meta { color: var(--texte-doux); font-size: 0.95rem; margin-bottom: 28px; display: flex; gap: 22px; flex-wrap: wrap; font-weight: 600; }
  .detail-content h4 { font-family: 'Playfair Display', serif; color: var(--texte); font-size: 1.25rem; margin: 28px 0 14px; font-weight: 700; }
  .detail-content ol { padding-left: 24px; color: var(--texte-doux); }
  .detail-content ol li { margin-bottom: 10px; line-height: 1.7; font-weight: 500; }
  .detail-content ul { background: linear-gradient(135deg, var(--menthe-pale), var(--lavande-pale)); padding: 18px 18px 18px 40px; border-radius: var(--rayon); list-style: none; color: var(--texte-doux); font-weight: 500; }
  .detail-content ul li { margin-bottom: 8px; line-height: 1.6; position: relative; }
  .detail-content ul li::before { content: "🌸"; position: absolute; left: -24px; font-size: 0.85rem; }
  .detail-actions { margin-top: 32px; display: flex; gap: 14px; flex-wrap: wrap; }
  .detail-actions a { text-decoration: none; display: inline-block; }
  .back-link { display: inline-block; color: var(--lavande-deep); text-decoration: none; font-weight: 700; margin-bottom: 22px; transition: var(--transition); }
  .back-link:hover { color: var(--rose-deep); }
  @media (max-width: 700px) { .detail-hero img { height: 220px; } .detail-content { padding: 22px; } .detail-content h1 { font-size: 1.5rem; } }
